{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dacn:schema:execution-record",
  "title": "DACN execution record",
  "type": "object",
  "allOf": [
    {
      "$ref": "urn:dacn:schema:common#/$defs/record_envelope"
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "process"
        ]
      },
      "else": {
        "required": [
          "failure"
        ]
      }
    }
  ],
  "required": [
    "schema",
    "id",
    "case_id",
    "provenance",
    "role",
    "comparison_group",
    "build_id",
    "executable",
    "input",
    "input_role",
    "command",
    "working_directory",
    "environment",
    "limits",
    "status",
    "started_at",
    "completed_at",
    "stdout",
    "stderr"
  ],
  "properties": {
    "schema": {
      "const": "execution-record"
    },
    "id": {},
    "case_id": {},
    "provenance": {},
    "role": {
      "$ref": "urn:dacn:schema:common#/$defs/execution_role"
    },
    "comparison_group": {
      "type": "string",
      "minLength": 1
    },
    "build_id": {
      "$ref": "urn:dacn:schema:common#/$defs/record_id"
    },
    "executable": {
      "$ref": "urn:dacn:schema:common#/$defs/artifact_ref"
    },
    "input": {
      "$ref": "urn:dacn:schema:common#/$defs/artifact_ref"
    },
    "input_role": {
      "enum": [
        "candidate",
        "benign_control"
      ]
    },
    "command": {
      "$ref": "urn:dacn:schema:common#/$defs/command"
    },
    "working_directory": {
      "$ref": "urn:dacn:schema:common#/$defs/relative_path"
    },
    "environment": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "limits": {
      "$ref": "urn:dacn:schema:common#/$defs/limits"
    },
    "status": {
      "enum": [
        "completed",
        "timed_out",
        "resource_limited",
        "startup_failed",
        "harness_failed"
      ]
    },
    "started_at": {
      "$ref": "urn:dacn:schema:common#/$defs/timestamp"
    },
    "completed_at": {
      "$ref": "urn:dacn:schema:common#/$defs/timestamp"
    },
    "stdout": {
      "$ref": "urn:dacn:schema:common#/$defs/artifact_ref"
    },
    "stderr": {
      "$ref": "urn:dacn:schema:common#/$defs/artifact_ref"
    },
    "process": {
      "type": "object",
      "properties": {
        "exit_code": {
          "type": "integer",
          "minimum": 0
        },
        "signal": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "exit_code"
          ]
        },
        {
          "required": [
            "signal"
          ]
        }
      ],
      "additionalProperties": false
    },
    "failure": {
      "$ref": "urn:dacn:schema:common#/$defs/failure"
    },
    "sanitizer_report": {
      "$ref": "urn:dacn:schema:common#/$defs/artifact_ref"
    },
    "stack_trace": {
      "$ref": "urn:dacn:schema:common#/$defs/artifact_ref"
    },
    "coverage_summary": {
      "$ref": "urn:dacn:schema:common#/$defs/artifact_ref"
    },
    "generated_outputs": {
      "type": "array",
      "items": {
        "$ref": "urn:dacn:schema:common#/$defs/artifact_ref"
      }
    },
    "resource_usage": {
      "type": "object",
      "properties": {
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "peak_memory_mb": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "output_truncated": {
      "type": "boolean"
    }
  },
  "unevaluatedProperties": false
}
