{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dacn:schema:verification-result",
  "title": "DACN verification result",
  "type": "object",
  "allOf": [
    {
      "$ref": "urn:dacn:schema:common#/$defs/record_envelope"
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "VERIFIED"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "required": [
          "executions"
        ],
        "not": {
          "required": [
            "failure_class"
          ]
        },
        "properties": {
          "executions": {
            "required": [
              "vulnerable",
              "patched",
              "negative_controls"
            ]
          },
          "checks": {
            "$ref": "#/$defs/all_passed"
          }
        }
      },
      "else": {
        "required": [
          "failure_class"
        ],
        "properties": {
          "checks": {
            "not": {
              "$ref": "#/$defs/all_passed"
            }
          }
        }
      }
    }
  ],
  "required": [
    "schema",
    "id",
    "case_id",
    "provenance",
    "expectations",
    "checks",
    "verdict",
    "rationale",
    "evidence",
    "oracle"
  ],
  "properties": {
    "schema": {
      "const": "verification-result"
    },
    "id": {},
    "case_id": {},
    "provenance": {},
    "expectations": {
      "type": "object",
      "required": [
        "target_signal",
        "reachability",
        "patched_behavior"
      ],
      "properties": {
        "target_signal": {
          "type": "string",
          "minLength": 1
        },
        "reachability": {
          "type": "string",
          "minLength": 1
        },
        "patched_behavior": {
          "type": "string",
          "minLength": 1
        },
        "safe_behavior_signals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "executions": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "vulnerable": {
          "$ref": "urn:dacn:schema:common#/$defs/record_id"
        },
        "patched": {
          "$ref": "urn:dacn:schema:common#/$defs/record_id"
        },
        "negative_controls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:dacn:schema:common#/$defs/record_id"
          }
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "$ref": "#/$defs/check_set"
    },
    "verdict": {
      "$ref": "urn:dacn:schema:common#/$defs/verdict"
    },
    "failure_class": {
      "$ref": "urn:dacn:schema:common#/$defs/failure_class"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:dacn:schema:common#/$defs/artifact_ref"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "oracle": {
      "type": "object",
      "required": [
        "name",
        "version",
        "adapter",
        "case_definition"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "adapter": {
          "type": "object",
          "required": [
            "name",
            "version",
            "implementation"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "implementation": {
              "$ref": "urn:dacn:schema:common#/$defs/artifact_ref"
            }
          },
          "additionalProperties": false
        },
        "case_definition": {
          "$ref": "urn:dacn:schema:common#/$defs/artifact_ref"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": [
        "status",
        "summary",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_evaluated"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "urn:dacn:schema:common#/$defs/artifact_ref"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_evaluated"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          },
          "else": {
            "not": {
              "required": [
                "reason"
              ]
            },
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "passed_check": {
      "allOf": [
        {
          "$ref": "#/$defs/check"
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "passed"
            }
          }
        }
      ]
    },
    "all_passed": {
      "properties": {
        "environment_and_build_identity": {
          "$ref": "#/$defs/passed_check"
        },
        "same_candidate": {
          "$ref": "#/$defs/passed_check"
        },
        "vulnerable_target_signal": {
          "$ref": "#/$defs/passed_check"
        },
        "reachability": {
          "$ref": "#/$defs/passed_check"
        },
        "patched_behavior": {
          "$ref": "#/$defs/passed_check"
        },
        "negative_controls": {
          "$ref": "#/$defs/passed_check"
        },
        "patch_consistency": {
          "$ref": "#/$defs/passed_check"
        }
      }
    },
    "check_set": {
      "type": "object",
      "required": [
        "environment_and_build_identity",
        "same_candidate",
        "vulnerable_target_signal",
        "reachability",
        "patched_behavior",
        "negative_controls",
        "patch_consistency"
      ],
      "properties": {
        "environment_and_build_identity": {
          "$ref": "#/$defs/check"
        },
        "same_candidate": {
          "$ref": "#/$defs/check"
        },
        "vulnerable_target_signal": {
          "$ref": "#/$defs/check"
        },
        "reachability": {
          "$ref": "#/$defs/check"
        },
        "patched_behavior": {
          "$ref": "#/$defs/check"
        },
        "negative_controls": {
          "$ref": "#/$defs/check"
        },
        "patch_consistency": {
          "$ref": "#/$defs/check"
        }
      },
      "additionalProperties": false
    }
  },
  "unevaluatedProperties": false
}
